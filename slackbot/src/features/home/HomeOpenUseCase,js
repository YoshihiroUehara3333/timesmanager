// src/features/home/HomeOpenUseCase.js

const { HomeBlocks } = require('./HomeBlocks')
const { getDate } = require('../../utility/DateUtils')

class HomeOpenUseCase {
    constructor({ slackGateway, backendGateway }) {
        this.slackGateway = slackGateway
        this.backendGateway = backendGateway
    }

    async execute({ userId }) {
        // スレッド存在確認
        const date = getDate('YYYY-MM-DD')
        let thread = await this.backendGateway.getThread({userId, date})

        let tasks = []
        if (thread) {
            // タスクリスト取得
            tasks = await this.backendGateway.getTasks({userId})
            if (tasks.length) {
                // activeなもので絞り込む
                tasks = tasks.filter((task) => task.status === TaskConst.STATUS.ACTIVE)
            }
        }
        
        // BlockKit作成
        const view = HomeBlocks({
            tasks: tasks,
            thread: thread,
        })

        // ホーム画面を更新
        this.slackGateway.updateHome({
            userId: userId,
            view: view,
        })
    }
}

module.exports = { HomeOpenUseCase }